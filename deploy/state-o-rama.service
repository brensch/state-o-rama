# state-o-rama on the brensch.com box (installed by deploy/setup-vm.sh).
# Listens on 127.0.0.1:8050; Caddy proxies state-o-rama.brensch.com to it
# (WebSockets included). No disk state: lobbies live in memory.
[Unit]
Description=state-o-rama
After=network-online.target
Wants=network-online.target

[Service]
User=stateorama
ExecStart=/opt/state-o-rama/state-o-rama
Environment=BIND=127.0.0.1:8050
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=200M

[Install]
WantedBy=multi-user.target
